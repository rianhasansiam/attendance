{
  "name": "attendance-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build && node scripts/prepare-standalone.mjs",
    "build:standalone": "node scripts/prepare-standalone.mjs",
    "start": "HOSTNAME=127.0.0.1 node .next/standalone/server.js",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test:overtime": "node --conditions react-server --import tsx --experimental-test-module-mocks --test --test-concurrency=1 tests/overtime*.test.ts",
    "test:company-money": "node --conditions react-server --import tsx --experimental-test-module-mocks --test --test-concurrency=1 tests/company-money-*.test.ts",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate deploy",
    "db:dev": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:cleanup": "tsx scripts/cleanup.ts",
    "format": "prettier --write src tests scripts prisma/seed.ts *.ts *.mjs",
    "format:check": "prettier --check src tests scripts prisma/seed.ts *.ts *.mjs"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@reduxjs/toolkit": "^2.12.0",
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.0.2",
    "argon2": "^0.45.1",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "docx": "^9.9.0",
    "dotenv": "^18.0.0",
    "ipaddr.js": "^2.5.0",
    "lucide-react": "^1.47.0",
    "next": "16.3.5",
    "next-auth": "5.0.0-beta.32",
    "next-intl": "4.14.7",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-redux": "^9.3.0",
    "server-only": "^0.0.1",
    "sweetalert2": "^11.26.25",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.13.5",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "prettier": "^3.9.8",
    "prisma": "7.10.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5"
  },
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=22.12.0"
  }
}
