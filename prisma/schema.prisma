generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
}
enum Role {
  SUPER_ADMIN
  ADMIN
  EMPLOYEE
  MANAGE_DRIVER
}
enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}
enum AttendanceStatus {
  PRESENT
  LATE
  ABSENT
  HALF_DAY
  LEAVE
  HOLIDAY
  WEEKEND
}
enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}
enum LateApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}
enum ChallengePurpose {
  REGISTRATION
  CHECK_IN
  CHECK_OUT
}
enum DriveCostRateType {
  IN_TIME
  OVER_TIME
}
enum DriveCostPaymentStatus {
  UNPAID
  PAID
}
enum DailyExpenseTransactionType {
  BALANCE_ADDED
  EXPENSE
}
model User {
  id String @id @default(cuid())
  name String?
  email String @unique
  emailVerified DateTime?
  image String?
  googleAccountId String? @unique
  passwordHash String?
  role Role @default(EMPLOYEE)
  status UserStatus @default(ACTIVE)
  lastLoginAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  accounts Account[]
  sessions Session[]
  passwordResetTokens PasswordResetToken[]
  employee Employee?
  auditLogs AuditLog[]
  driveCosts DriveCost[]
  dailyExpenseTransactions DailyExpenseTransaction[]
  reviewedLateApprovals LateApprovalRequest[]
}
model Account {
  id String @id @default(cuid())
  userId String
  type String
  provider String
  providerAccountId String
  refresh_token String? @db.Text
  access_token String? @db.Text
  expires_at Int?
  token_type String?
  scope String?
  id_token String? @db.Text
  session_state String?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([provider, providerAccountId])
  @@index([userId])
}
model Session {
  id String @id @default(cuid())
  sessionToken String @unique
  userId String
  expires DateTime
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@index([expires])
}
model PasswordResetToken {
  id String @id @default(cuid())
  userId String
  email String
  tokenHash String @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  usedAt DateTime?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@index([expiresAt])
}
model Employee {
  id String @id @default(cuid())
  employeeCode String @unique
  userId String @unique
  departmentId String?
  officeId String
  joinedAt DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  department Department? @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  office Office @relation(fields: [officeId], references: [id], onDelete: Restrict)
  shifts EmployeeShift[]
  credentials WebAuthnCredential[]
  challenges WebAuthnChallenge[]
  attendances Attendance[]
  events AttendanceEvent[]
  leaves Leave[]
  @@index([officeId])
  @@index([departmentId])
}
model Department {
  id String @id @default(cuid())
  name String @unique
  active Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  employees Employee[]
}
model Office {
  id String @id @default(cuid())
  name String
  address String
  latitude Float
  longitude Float
  geofenceRadiusMeters Int @default(100)
  timezone String @default("UTC")
  active Boolean @default(true)
  requireWebAuthn Boolean @default(true)
  requireGeofence Boolean @default(true)
  requireOfficeNetwork Boolean @default(true)
  requireApprovedDevice Boolean @default(true)
  maximumGpsAccuracyMeters Int @default(50)
  weekendDays Int[] @default([0, 6])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  employees Employee[]
  networks OfficeNetwork[]
  attendances Attendance[]
  holidays Holiday[]
}
model OfficeNetwork {
  id String @id @default(cuid())
  officeId String
  publicIpOrCidr String
  active Boolean @default(true)
  description String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  office Office @relation(fields: [officeId], references: [id], onDelete: Cascade)
  @@unique([officeId, publicIpOrCidr])
}
model Shift {
  id String @id @default(cuid())
  name String
  startTime String
  endTime String
  graceMinutes Int @default(15)
  halfDayThreshold Int @default(240)
  timezone String @default("UTC")
  active Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  employees EmployeeShift[]
  attendances Attendance[]
}
model EmployeeShift {
  id String @id @default(cuid())
  employeeId String
  shiftId String
  startDate DateTime @db.Date
  endDate DateTime? @db.Date
  createdAt DateTime @default(now())
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  shift Shift @relation(fields: [shiftId], references: [id], onDelete: Restrict)
  @@unique([employeeId, startDate])
  @@index([employeeId, endDate])
}
model WebAuthnCredential {
  id String @id @default(cuid())
  employeeId String
  name String
  credentialId String @unique
  publicKey Bytes
  counter BigInt @default(0)
  transports String[]
  deviceType String
  backedUp Boolean @default(false)
  approved Boolean @default(false)
  createdAt DateTime @default(now())
  revokedAt DateTime?
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  @@index([employeeId, revokedAt])
}
model WebAuthnChallenge {
  id String @id @default(cuid())
  employeeId String
  sessionId String
  challenge String @unique
  purpose ChallengePurpose
  expiresAt DateTime
  usedAt DateTime?
  createdAt DateTime @default(now())
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  @@index([employeeId, purpose])
  @@index([expiresAt])
}
model Attendance {
  id String @id @default(cuid())
  employeeId String
  officeId String
  shiftId String
  attendanceDate DateTime @db.Date
  /// Scheduled start captured for review; null for historical records.
  scheduledStartAt DateTime?
  /// Scheduled shift end captured at check-in; null only for legacy records.
  scheduledEndAt DateTime?
  checkInAt DateTime?
  checkOutAt DateTime?
  checkInLatitude Float?
  checkInLongitude Float?
  checkInAccuracy Float?
  checkInDistanceMeters Float?
  checkInIp String?
  checkOutLatitude Float?
  checkOutLongitude Float?
  checkOutAccuracy Float?
  checkOutDistanceMeters Float?
  checkOutIp String?
  checkInCredentialId String?
  checkOutCredentialId String?
  status AttendanceStatus
  lateMinutes Int @default(0)
  lateReason String? @db.VarChar(1000)
  workedMinutes Int @default(0)
  /// Completed after-hours minutes minus actual late minutes. Null means unknown legacy overtime.
  overtimeMinutes Int? @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  office Office @relation(fields: [officeId], references: [id], onDelete: Restrict)
  shift Shift @relation(fields: [shiftId], references: [id], onDelete: Restrict)
  events AttendanceEvent[]
  lateApproval LateApprovalRequest?
  @@unique([employeeId, attendanceDate])
  @@index([officeId, attendanceDate])
  @@index([status, attendanceDate])
  @@index([shiftId, attendanceDate])
  @@index([updatedAt(sort: Desc), id(sort: Desc)])
}
model LateApprovalRequest {
  id String @id @default(cuid())
  attendanceId String @unique
  status LateApprovalStatus @default(PENDING)
  /// Immutable attendance facts at submission; approval only excuses matching facts.
  checkInAt DateTime
  scheduledStartAt DateTime?
  lateMinutes Int
  reason String @db.VarChar(1000)
  requestedAt DateTime @default(now())
  reviewedById String?
  reviewedAt DateTime?
  reviewNote String? @db.VarChar(1000)
  attendance Attendance @relation(fields: [attendanceId], references: [id], onDelete: Restrict)
  reviewedBy User? @relation(fields: [reviewedById], references: [id], onDelete: Restrict)
  @@index([status, requestedAt(sort: Desc), id(sort: Desc)])
  @@index([reviewedById])
}
model AttendanceEvent {
  id String @id @default(cuid())
  employeeId String?
  attendanceId String?
  type String
  reason String?
  metadata Json?
  createdAt DateTime @default(now())
  employee Employee? @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  attendance Attendance? @relation(fields: [attendanceId], references: [id], onDelete: Restrict)
  @@index([employeeId, createdAt])
  @@index([type, createdAt])
}
model Holiday {
  id String @id @default(cuid())
  name String
  date DateTime @db.Date
  officeId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  office Office? @relation(fields: [officeId], references: [id], onDelete: Restrict)
  @@unique([officeId, date])
  @@index([date])
}
model DriveCost {
  id String @id @default(cuid())
  date DateTime @db.Date
  destinationFrom String @db.VarChar(160)
  destinationTo String @db.VarChar(160)
  kilometers Decimal @db.Decimal(10, 2)
  isRoundTrip Boolean @default(false)
  rateType DriveCostRateType
  paymentStatus DriveCostPaymentStatus @default(UNPAID)
  ratePerKilometer Decimal @db.Decimal(10, 2)
  totalCost Decimal @db.Decimal(12, 2)
  createdById String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy User @relation(fields: [createdById], references: [id], onDelete: Restrict)
  @@index([date(sort: Desc), id(sort: Desc)])
  @@index([createdById, date(sort: Desc)])
}
model Leave {
  id String @id @default(cuid())
  employeeId String
  startDate DateTime @db.Date
  endDate DateTime @db.Date
  reason String
  status LeaveStatus @default(PENDING)
  reviewedById String?
  reviewNote String?
  reviewedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  @@index([employeeId, startDate, endDate])
  @@index([status])
}
model AuditLog {
  id String @id @default(cuid())
  actorId String?
  action String
  resource String
  resourceId String?
  previousState Json?
  newState Json?
  createdAt DateTime @default(now())
  actor User? @relation(fields: [actorId], references: [id], onDelete: Restrict)
  @@index([createdAt])
  @@index([resource, resourceId])
}
model RateLimit {
  key String @id
  count Int
  resetAt DateTime
  @@index([resetAt])
}
model SystemSetting {
  key String @id
  value Json
  updatedAt DateTime @updatedAt
}

model DailyExpenseLedger {
  id String @id @default(cuid())
  workspaceKey String @unique @db.VarChar(64)
  currency String @db.VarChar(3)
  timezone String @db.VarChar(100)
  createdAt DateTime @default(now())
  categories DailyExpenseCategory[]
  transactions DailyExpenseTransaction[]
}

model DailyExpenseCategory {
  id String @id @default(cuid())
  ledgerId String
  name String @db.VarChar(80)
  /// PostgreSQL generates Unicode lowercase with und-x-icu; callers cannot override it.
  normalizedName String @default(dbgenerated())
  archived Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ledger DailyExpenseLedger @relation(fields: [ledgerId], references: [id], onDelete: Restrict)
  transactions DailyExpenseTransaction[]
  @@unique([ledgerId, normalizedName])
  @@unique([ledgerId, id])
  @@index([ledgerId, archived, name])
}

model DailyExpenseTransaction {
  id String @id @default(cuid())
  version Int @default(1)
  deletedAt DateTime?
  ledgerId String
  type DailyExpenseTransactionType
  amount Decimal @db.Decimal(18, 2)
  categoryId String?
  date DateTime @db.Date
  note String? @db.VarChar(1000)
  createdById String
  createdAt DateTime @default(now())
  idempotencyKey String @db.VarChar(128)
  payloadHash String @db.VarChar(64)
  ledger DailyExpenseLedger @relation(fields: [ledgerId], references: [id], onDelete: Restrict)
  category DailyExpenseCategory? @relation(fields: [ledgerId, categoryId], references: [ledgerId, id], onDelete: Restrict, onUpdate: Restrict)
  createdBy User @relation(fields: [createdById], references: [id], onDelete: Restrict)
  @@unique([ledgerId, idempotencyKey])
  @@index([ledgerId, date(sort: Desc), createdAt(sort: Desc), id(sort: Desc)])
  @@index([ledgerId, type, date(sort: Desc)])
  @@index([ledgerId, categoryId, date(sort: Desc)])
  @@index([createdById])
}
